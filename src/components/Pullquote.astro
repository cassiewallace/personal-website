---
// Pullquote — styled blockquote for writing pages
// Usage: <Pullquote>"Quote text here."</Pullquote>
---

<blockquote class="pullquote">
  <slot />
</blockquote>

<style>
  .pullquote {
    background: #fff;
    border: 3px solid #000;
    padding: 24px;
    box-shadow: 6px 6px 0 #000;
    margin: 36px 0;
    font-size: 16px;
    line-height: 1.5;
    font-style: italic;
  }
</style>
