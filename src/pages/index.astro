---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="page">

    <!-- Hero -->
    <div class="hero">
      <h1 class="headline">Hi! I'm Cassie.</h1>
      <p class="bio">
        I'm an iOS Engineer living in Summit County, Colorado. I bring a
        product-focused perspective to building high-quality mobile apps.
      </p>
      <p class="bio">
        I work at <a href="https://www.faynutrition.com/">Fay</a>, a platform
        that pairs registered dietitians with technology to deliver affordable,
        expert-led care to the people who need it most.
      </p>
      <a href="https://www.linkedin.com/in/cassiebwallace/" class="cta">Say hello</a>
    </div>

    <div class="divider"></div>

    <!-- Footer -->
    <footer class="footer">
      <div>iOS · Swift · SwiftUI · UIKit</div>
      <div>© 2026</div>
    </footer>

  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    padding: 72px 64px 56px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* Hero — flex-grow pushes divider + footer to the bottom on tall viewports */
  .hero {
    flex-grow: 1;
    padding-bottom: 96px;
  }

  .headline {
    font-size: 64px;
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
  }

  .bio {
    font-size: 19px;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0;
  }

  .hero .bio:first-of-type {
    margin-top: 40px;
  }

  .hero .bio + .bio {
    margin-top: 22px;
  }

  .cta {
    display: inline-block;
    margin-top: 30px;
    background: #c8d900;
    border: 3px solid #000;
    padding: 14px 26px;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 5px 5px 0 #000;
    color: #000;
  }

  .cta:hover {
    border-bottom-color: #000;
  }

  /* Divider */
  .divider {
    height: 1px;
    background: #c8d900;
  }

  /* Footer */
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 22px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .page {
      padding: 48px 24px 40px;
    }

    .headline {
      font-size: 40px;
    }

    .hero {
      padding-bottom: 64px;
    }
  }
</style>
