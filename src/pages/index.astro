---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="container">
    <div class="row">
      <div class="twelve column" style="margin-top: 10%">

        <h1><b>Hi! I'm Cassie.</b></h1>

        <p style="font-size:1.5em; line-height:1.5em">
          <b>I'm an iOS Engineer living in the Colorado Rockies.</b>
          After spending almost a decade as a product person, working with
          engineering teams to build iOS and Android apps for retailers,
          as well as SaaS products for complex fields like taxes, duties,
          and environmental compliance, I made the switch to iOS development.
        </p>

        <p style="font-size:.9em; font-style: italic; line-height:1.5em; padding-top:50px">
          Built with ♥ in Summit County, CO
        </p>

      </div>
    </div>
  </div>
</BaseLayout>
