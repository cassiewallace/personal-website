---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="container">
    <div class="row">
      <div class="twelve column" style="margin-top: 10%">

        <h1><b>Hi! I'm Cassie.</b></h1>

        <p style="font-size:1.5em; line-height:1.5em">
          <b>I'm an iOS Engineer living in Summit County, Colorado.</b>
          I bring a product-focused perspective to building
          high-quality mobile apps.
        </p>

        <p style="font-size:1.5em; line-height:1.5em">
          I work at <a href="https://www.faynutrition.com/">Fay</a>, a platform
          that pairs registered dietitians with technology to deliver affordable,
          expert-led care to the people who need it most.
        </p>

      </div>
    </div>
  </div>
</BaseLayout>
