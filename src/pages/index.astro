---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';

const work = [
  {
    href: 'https://apps.apple.com/us/app/fay-nutrition-dietitians/id6711357628',
    title: 'Fay',
    desc: 'Expert nutrition care, covered by insurance.',
  },
  {
    href: '/dotfiles',
    title: 'dotfiles',
    desc: 'Shell config, Claude Code setup, and agent skills for iOS engineers.',
    label: 'open source',
  },
  {
    href: 'https://apps.apple.com/us/app/handshake-jobs-new-careers/id1220620171',
    title: 'Handshake',
    desc: 'Early career jobs for students and new grads.',
  },
];
---

<BaseLayout>
  <div class="page">

    <!-- Hero -->
    <div class="hero">
      <h1 class="headline">Hi! I'm Cassie.</h1>
      <p class="bio">
        I'm an <strong>iOS Engineer</strong> living in Colorado. I bring a
        product-focused perspective to building high-quality mobile apps.
      </p>
      <a href="https://www.linkedin.com/in/cassiebwallace/" class="cta">Say hello</a>
    </div>

    <div class="divider"></div>

    <!-- Work -->
    <section class="work">
      <div class="cards">
        {work.map((item) => (
          <WorkCard href={item.href} title={item.title} desc={item.desc} label={item.label} />
        ))}
      </div>
    </section>

    <div class="divider"></div>

    <!-- Footer -->
    <footer class="footer">
      <div>iOS · Swift · SwiftUI · UIKit</div>
      <div>© 2026</div>
    </footer>

  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    padding: 72px 64px 56px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .hero {
    padding-bottom: 56px;
  }

  .headline {
    font-size: 64px;
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
  }

  .bio {
    font-size: 19px;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0;
  }

  .hero .bio:first-of-type {
    margin-top: 40px;
  }

  .hero .bio + .bio {
    margin-top: 22px;
  }

  .cta {
    display: inline-block;
    margin-top: 30px;
    background: #c8d900;
    border: 3px solid #000;
    padding: 14px 26px;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 5px 5px 0 #000;
    color: #000;
    transition: box-shadow 0.1s, transform 0.1s;
  }

  .cta:hover {
    box-shadow: 2px 2px 0 #000;
    transform: translate(3px, 3px);
    border-bottom-color: #000;
  }

  /* Divider */
  .divider {
    height: 1px;
    background: #c8d900;
  }

  /* Work */
  .work {
    padding: 44px 0 48px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  /* Footer */
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 22px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .page {
      padding: 48px 24px 40px;
    }

    .headline {
      font-size: 40px;
    }

    .hero {
      padding-bottom: 64px;
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
